# Supabase project URL (Settings -> API)
VITE_SUPABASE_URL=https://kcrefqgqwvtioosfbefb.supabase.co

# Supabase public anon key (Settings -> API -> Project API keys -> anon public)
# This is the browser-safe public key. NEVER put the service-role key here.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Backend API Base URL (Render deployment URL in production, http://localhost:5000 in local development)
VITE_BACKEND_URL=

